import pickle
import numpy as np

# Load the trained model
with open("song_popularity_model.pkl", "rb") as f:
    model = pickle.load(f)

print("\n SONG POPULARITY PREDICTOR \n")

# Take input values from user
acousticness = float(input("Acousticness (0-1): "))
danceability = float(input("Danceability (0-1): "))
duration_ms = int(input("Duration (in milliseconds): "))
energy = float(input("Energy (0-1): "))
instrumentalness = float(input("Instrumentalness (0-1): "))
key = int(input("Musical Key (0-11): "))
liveness = float(input("Liveness (0-1): "))
mode = int(input("Mode (0 = Minor, 1 = Major): "))
speechiness = float(input("Speechiness (0-1): "))
tempo = float(input("Tempo (BPM): "))
time_signature = int(input("Time Signature (typically 3,4,5): "))
valence = float(input("Valence (0-1): "))

# Arrange features in correct order for model
features = np.array([[
    acousticness, danceability, duration_ms, energy,
    instrumentalness, key, liveness, mode,
    speechiness, tempo, time_signature, valence
]])

# Predict
prediction = model.predict(features)[0]

# Result
if prediction == 1:
    print("\n RESULT: This is predicted to be a **HIGH POPULARITY SONG** ")
else:
    print("\n RESULT: This is predicted to be a **LOW POPULARITY SONG** ")
